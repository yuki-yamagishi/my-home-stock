{
  "name": "myhomestock",
  "version": "0.1.0",
  "private": true,
  "description": "MyHomeStock - 自宅在庫・買い物リスト管理 Web/PWA アプリケーション開発ハーネス",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check": "node scripts/securityCheck.js && node scripts/docCheck.js && npm --prefix frontend run type-check && npm --prefix frontend run test:run && npm --prefix frontend run build",
    "security-check": "node scripts/securityCheck.js",
    "doc-check": "node scripts/docCheck.js",
    "issue:switch": "node scripts/issueSwitch.js",
    "sync-api": "node scripts/syncApi.js",
    "test:backend": "mvnw.cmd test",
    "test:frontend": "npm --prefix frontend run test:run",
    "dev": "npm --prefix frontend run dev",
    "test": "npm --prefix frontend run test:run",
    "build": "npm --prefix frontend run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "keywords": [
    "pwa",
    "spring-boot",
    "vue",
    "typescript",
    "tailwind",
    "postgresql",
    "openapi"
  ],
  "author": "MyHomeStock Dev Team",
  "license": "MIT"
}
