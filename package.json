{
  "name": "myhomestock",
  "version": "0.1.0",
  "private": true,
  "description": "MyHomeStock - 自宅在庫・買い物リスト管理 Web/PWA アプリケーション開発ハーネス",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check": "node .agents/plugins/myhomestock/hooks/qualityGateRunner.js && npm --prefix frontend run type-check && npm --prefix frontend run test:run && npm --prefix frontend run build",
    "check:fast": "npm --prefix frontend run type-check",
    "check:docs": "node .agents/plugins/myhomestock/hooks/qualityGateRunner.js --docs-only",
    "test:fast": "npm --prefix frontend run test:run",
    "test:related": "npm --prefix frontend run test:run",
    "security-check": "node .agents/plugins/myhomestock/hooks/secretLeakGuard.js",
    "doc-check": "node .agents/plugins/myhomestock/hooks/docIntegrityGuard.js",
    "issue:switch": "node .agents/plugins/myhomestock/skills/issue-workflow/scripts/switch.js",
    "sync-api": "node .agents/plugins/myhomestock/skills/sync-api/scripts/sync.js",
    "test:backend": "mvnw.cmd test",
    "test:frontend": "npm --prefix frontend run test:run",
    "dev": "npm --prefix frontend run dev",
    "test": "npm --prefix frontend run test:run",
    "build": "npm --prefix frontend run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "keywords": [
    "pwa",
    "spring-boot",
    "react",
    "tanstack-query",
    "typescript",
    "tailwind",
    "postgresql",
    "openapi"
  ],
  "author": "MyHomeStock Dev Team",
  "license": "MIT"
}
