# ==============================================================================
# MyHomeStock Environment Variables Template (.env.example)
# Copy this file to .env on your deployment host and fill in actual values.
# ==============================================================================

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Allowed User Emails (Comma-separated)
ALLOWED_EMAILS=user1@example.com,user2@example.com

# CORS Allowed Origins (Comma-separated exact origins)
# For production, specify your exact domain (e.g. https://ymgs-mhs-j.duckdns.org)
# If left empty, defaults to local origins: http://localhost:*,http://127.0.0.1:*
CORS_ALLOWED_ORIGINS=https://ymgs-mhs-j.duckdns.org

# Container Image Repository & Tag (Optional)
# IMAGE_REPO=ghcr.io/yuki-yamagishi/my-home-stock
# IMAGE_TAG=latest

# Watchtower GitHub Container Registry Access (Optional for auto-update)
# GHCR_USER=your_github_username
# GHCR_PAT=your_github_personal_access_token
