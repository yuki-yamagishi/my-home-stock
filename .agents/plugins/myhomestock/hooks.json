{
  "openapi-sync-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/openapiSyncGuard.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
