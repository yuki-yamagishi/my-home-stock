#!/bin/sh
# Automated Quality Gate Guards before commit (.githooks/pre-commit)

echo "🏛️ [Git Hook] Running MyHomeStock Quality Gate Guards before commit..."
if command -v cmd.exe >/dev/null 2>&1; then
  cmd.exe /c "node .agents/plugins/myhomestock/hooks/qualityGateRunner.js"
else
  node .agents/plugins/myhomestock/hooks/qualityGateRunner.js
fi

if [ $? -ne 0 ]; then
  echo "❌ [Git Hook] Quality gate check FAILED. Commit aborted."
  exit 1
fi

echo "✅ [Git Hook] All quality gate guards passed. Proceeding with commit."
exit 0
