#!/bin/sh
# Automated Full Quality Check before push to remote

# Safely drain stdin to prevent Windows Git syntax errors ('refs' is not recognized...)
while read -r local_ref local_sha remote_ref remote_sha; do
  :
done

echo "🚀 [Git Pre-Push Hook] Running full quality & security check before push..."
if command -v cmd.exe >/dev/null 2>&1; then
  cmd.exe /c "npm.cmd run check"
else
  npm run check
fi
if [ $? -ne 0 ]; then
  echo "❌ [Git Pre-Push Hook] Quality Gate FAILED. Push aborted."
  exit 1
fi

echo "✅ [Git Pre-Push Hook] All quality gates passed. Proceeding with push to remote."
exit 0
